# SeuVoo — variáveis de ambiente. Copie para .env.local. Nunca versione segredos.

# URL pública do site (links de compartilhamento, e-mails, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Dados de voo ----------
# demo (padrão, dados sintéticos) | aeroapi (FlightAware AeroAPI)
FLIGHT_DATA_PROVIDER=demo
# Chave da AeroAPI — somente servidor
AEROAPI_KEY=
# AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# ---------- Persistência local ----------
# Pasta do armazenamento JSON local (dev/demonstração)
SEUVOO_DATA_DIR=.data
# Permite cookie de sessão sem HTTPS ao rodar `next start` localmente. NÃO use em produção.
# INSECURE_COOKIES=1

# ---------- Mapas ----------
# Estilo MapLibre. Padrão: OpenFreeMap (dados © OpenStreetMap, sem chave).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# ---------- E-mail (opcional) ----------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="SeuVoo <alertas@seu-dominio.com.br>"

# ---------- Cron ----------
# Segredo do endpoint /api/cron/atualizar-voos (Authorization: Bearer <segredo>)
CRON_SECRET=

# ---------- Supabase (adapter pendente; ver docs/ARCHITECTURE.md) ----------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
